rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Your dashboard data: only you can read or write your own document.
    match /life/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // FireCMS (your admin screen) signs in with the fireCMSUser claim.
    // Keep this rule: if you redeploy rules without it, FireCMS stops working.
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.fireCMSUser == true;
    }
  }
}
